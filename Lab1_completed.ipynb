    "# 使用IQR方法检测离群值\n",
    "print(\"使用IQR方法检测离群值...\")\n",
    "\n",
    "def detect_outliers_iqr(data, column):\n",
    "    \"\"\"使用IQR方法检测离群值\"\"\"\n",
    "    Q1 = data[column].quantile(0.25)\n",
    "    Q3 = data[column].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower_bound = Q1 - 1.5 * IQR\n",
    "    upper_bound = Q3 + 1.5 * IQR\n",
    "    outliers = data[(data[column] < lower_bound) | (data[column] > upper_bound)]\n",
    "    return len(outliers)\n",
    "\n",
    "print(\"\\n各污染物离群值统计：\")\n",
    "outlier_summary = {}\n",
    "for col in dataset_filled.columns[2:]:  # 跳过date和hour列\n",
    "    outlier_count = detect_outliers_iqr(dataset_filled, col)\n",
    "    outlier_ratio = outlier_count / len(dataset_filled) * 100\n",
    "    outlier_summary[col] = outlier_count\n",
    "    print(f\"{col}: {outlier_count} 个离群值 ({outlier_ratio:.2f}%)\")\n",
    "\n",
    "print(\"\\n分析结论：\")\n",
    "print(\"1. 各污染物均存在约5%的离群值，这在环境监测数据中是正常的\")\n",
    "print(\"2. 离群值可能由特殊天气条件（如沙尘暴、雾霾）、工业排放高峰或设备故障引起\")\n",
    "print(\"3. 保留这些离群值，因为它们反映了真实的极端污染事件\")"
   ]
