    "dataset_filled['datetime'] = pd.to_datetime(dataset_filled['date_str'], format='%Y%m%d')\n",
    "\n",
    "# 按日期计算日均AQI\n",
    "daily_aqi = dataset_filled.groupby('datetime')['AQI'].mean().reset_index()\n",
    "daily_aqi['year'] = daily_aqi['datetime'].dt.year\n",
    "daily_aqi['month'] = daily_aqi['datetime'].dt.month\n",
    "\n",
    "# 绘制AQI时间序列图\n",
    "plt.figure(figsize=(16, 8))\n",
    "plt.plot(daily_aqi['datetime'], daily_aqi['AQI'], linewidth=1, alpha=0.7, color='steelblue')\n",
    "\n",
    "# 添加趋势线\n",
    "z = np.polyfit(range(len(daily_aqi)), daily_aqi['AQI'], 1)\n",
    "p = np.poly1d(z)\n",
    "plt.plot(daily_aqi['datetime'], p(range(len(daily_aqi))), \"r--\", alpha=0.8, linewidth=2, label='趋势线')\n",
    "\n",
    "# 添加空气质量等级分界线\n",
